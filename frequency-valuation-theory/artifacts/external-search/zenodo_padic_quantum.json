{"hits": {"hits": [{"created": "2025-02-01T07:50:51.767601+00:00", "modified": "2025-02-01T07:53:56.396150+00:00", "id": 14784106, "conceptrecid": "14784105", "doi": "10.5281/zenodo.14784106", "conceptdoi": "10.5281/zenodo.14784105", "doi_url": "https://doi.org/10.5281/zenodo.14784106", "metadata": {"title": "TRR-NOTIME: Theory of Relative Reality - Without Time", "doi": "10.5281/zenodo.14784106", "publication_date": "2025-02-01", "description": "<p>TRR-NOTIME (Theory of Relative Reality - Without Time) presents an alternative perspective on physics, where time is not a fundamental quantity but merely a consequence of matter-energy interactions. This theory redefines the concept of gravity, nuclear decay, and quantum processes, enabling a unified understanding of physical reality without the need for a time dimension. The document summarizes the theory, its mathematical structure, and potential experimental validation.</p>", "access_right": "open", "creators": [{"name": "B\u0159ezina, Michal", "affiliation": null}], "resource_type": {"title": "Publication", "type": "publication"}, "license": {"id": "cc-by-4.0"}, "relations": {"version": [{"index": 0, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "14784105"}}]}}, "title": "TRR-NOTIME: Theory of Relative Reality - Without Time", "links": {"self": "https://zenodo.org/api/records/14784106", "self_html": "https://zenodo.org/records/14784106", "preview_html": "https://zenodo.org/records/14784106?preview=1", "doi": "https://doi.org/10.5281/zenodo.14784106", "self_doi": "https://doi.org/10.5281/zenodo.14784106", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.14784106", "reserve_doi": "https://zenodo.org/api/records/14784106/draft/pids/doi", "parent": "https://zenodo.org/api/records/14784105", "parent_html": "https://zenodo.org/records/14784105", "parent_doi": "https://doi.org/10.5281/zenodo.14784105", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.14784105", "self_iiif_manifest": "https:/